# Proxmox-Technitium Sync Service Configuration
# Copy this to /etc/proxmox-sync/.env and update with your values

# ============================================================
# PROXMOX SETTINGS
# ============================================================

# Proxmox Host (IP or hostname)
PROXMOX_HOST=pve-01.proxmox.local

# Proxmox Port (usually 8006)
PROXMOX_PORT=8006

# Proxmox Verify SSL Certificate (true/false)
PROXMOX_VERIFY_SSL=true

# Authentication Method: Choose one
# 1. Token-based (recommended)
# 2. Password-based (less secure)

# Token-based Authentication
PROXMOX_USERNAME=root@pam
PROXMOX_TOKEN_NAME=technitiumpve
PROXMOX_TOKEN_VALUE=be84cbbf-02e3-406a-94d2-07c4b17bfc9c

# Password-based Authentication (alternative to tokens)
# PROXMOX_USERNAME=root@pam
# PROXMOX_PASSWORD=your_password_here

# ============================================================
# TECHNITIUM SETTINGS
# ============================================================

# Technitium DNS Server Host (IP or hostname)
TECHNITIUM_HOST=dns.example.local

# Technitium DNS server port (usually 5380)
TECHNITIUM_PORT=5380

# Technitium API Token
TECHNITIUM_TOKEN=your_api_token_here

# Technitium DNS Zone (e.g., example.com)
ZONE=example.com

# ============================================================
# SERVICE SETTINGS
# ============================================================

# Polling interval in seconds (minimum: 10)
POLLING_INTERVAL=60

# Retry attempts for failed API calls
RETRY_ATTEMPTS=3

# Initial retry delay in seconds (exponential backoff)
RETRY_DELAY=1

# Maximum retries before logging error
MAX_RETRIES=5

# ============================================================
# LOGGING SETTINGS
# ============================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=/var/log/proxmox-sync/service.log

# ============================================================
# OPTIONAL SETTINGS
# ============================================================

# Enable SSL/TLS verification (should always be true in production)
VERIFY_SSL=true

# Custom CA Certificate Path (if needed)
# CA_CERT_PATH=/path/to/ca-bundle.crt

# Syslog configuration (for centralized logging)
SYSLOG_ENABLED=false
SYSLOG_HOST=localhost
SYSLOG_PORT=514
