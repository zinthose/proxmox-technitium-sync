# Proxmox Configuration
PROXMOX_HOST=pve-01.proxmox.local # You could use a loadbalanced VIP/hostname here if you have multiple Proxmox nodes
PROXMOX_USER=root
PROXMOX_REALM=pam

# Authentication (choose ONE method):
# Method 1: Token-based (recommended, more secure)
PROXMOX_TOKEN_NAME=technitiumpvesync
PROXMOX_TOKEN_VALUE=YOUR_TOKEN_SECRET_HERE

# Method 2: Password-based (fallback if tokens don't work)
# PROXMOX_PASSWORD=your-proxmox-password

# Technitium DNS Configuration
TECHNITIUM_TOKEN=SECRET_TECHNITIUM_TOKEN
TECHNITIUM_URL=http://technitium.local:5380

# DNS Zone Configuration
ZONE=local.pve

# Polling Configuration (in seconds, minimum 10s to prevent API flooding)
POLL_INTERVAL=60

# SSL/TLS Certificate Verification (default: true for security)
# Set to 'false' ONLY if using self-signed certs and you understand the risks
VERIFY_SSL=true
